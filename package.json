{
  "name": "php-wasm-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "webpack serve --mode development",
    "test": "php tests/run.php && php tests/phpdoc.php",
    "bench:ecs": "php benchmarks/ecs.php",
    "bench:ecs:browser": "node scripts/bench-ecs-browser.mjs",
    "test:tiled": "node --test tests/tiled.mjs",
    "test:browser": "playwright test",
    "lint": "npm run lint:js",
    "lint:js": "eslint .",
    "lint:fix": "npm run lint:js:fix",
    "lint:js:fix": "eslint . --fix",
    "build:docs": "webpack --mode production && node scripts/build-docs.mjs",
    "setup:runtime": "node scripts/runtime.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "9.39.5",
    "html-webpack-plugin": "^5.6.8",
    "sm-no-saccade-style": "github:seanmorris/sm-no-saccade-style#66f7b3ea71e99d0ee8c80409ddbd633a3a8e3e05",
    "style-loader": "^4.0.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
