{
  "name": "@seanmorris/php-slalom",
  "version": "0.1.0",
  "description": "A deterministic PHP and Phonics port of the rare Jet Slalom Java game",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    "./phonics.json": "./phonics.json"
  },
  "peerDependencies": {
    "@seanmorris/phonics": "0.1.0"
  },
  "peerDependenciesMeta": {
