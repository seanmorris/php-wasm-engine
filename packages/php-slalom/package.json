    }
  },
  "files": [
    "autoload.php",
    "game.php",
    "src/Input/InputSettings.php",
    "src/Input/SlalomActions.php",
    "src/Obstacle.php",
    "src/Random.php",
    "src/Render/Scene.php",
    "src/Replay.php",
    "src/Simulation.php",
    "src/Stage.php",
    "browser/game.mjs",
    "assets/bomb.wav",
    "assets/craft.tsj",
    "assets/jiki.png",
    "assets/jiki2.png",
    "worlds/slalom.tmj",
    "worlds/slalom.world",
    "phonics.json",
    "composer.json",
    "README.md",
    "LICENSE"
