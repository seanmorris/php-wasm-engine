{
  "name": "seanmorris/sane-phonics",
  "description": "Tiled-authored sane-phonics game and reusable modules for Phonics",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.0",
    "seanmorris/phonics": "^0.1.0"
  },
  "autoload": {
    "psr-4": {
      "SanePhonics\\": "src/"
    },
    "files": [
      "autoload.php"
    ]
  },
  "archive": {
    "exclude": [
      "/tests",
      "/generate-*",
      "/browser/legacy-host.mjs",
      "/examples/generate-*"
    ]
  },
  "version": "0.1.0"
}
