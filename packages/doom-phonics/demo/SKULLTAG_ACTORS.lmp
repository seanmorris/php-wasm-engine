	Inventory.MaxAmount 0
	Powerup.Type QuarterDamage
	Powerup.Color GreenMap
	Inventory.PickupMessage "$PICKUP_GUARDSPHERE"
	Inventory.PickupAnnouncerEntry "guardsphere"
	States
	{
