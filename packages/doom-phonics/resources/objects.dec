{}

ACTOR RedTeamStart : DoomPlayer 5081
{}

ACTOR WhiteTeamStart : DoomPlayer 5082
{}

ACTOR GreenTeamStart : DoomPlayer 5083
{}

ACTOR GoldTeamStart : DoomPlayer 5084
{}

// Armor

ACTOR Armor : Inventory native
{
  Inventory.PickupSound "misc/armor_pkup"
}

ACTOR BasicArmorPickup : Armor native
{
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
}

ACTOR BasicArmorBonus : Armor native
{
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Inventory.MaxAmount 0
  Armor.SavePercent 33.335
}

ACTOR GreenArmor : BasicArmorPickup 2018
{
  Radius 20
  Height 16
  Inventory.PickupMessage "$GOTARMOR" // "Picked up the armor."
  Inventory.Icon "ARM1A0"
  Armor.SavePercent 33.335
  Armor.SaveAmount 100
  States
  {
  Spawn:
    ARM1 A 6
    ARM1 B 7 Bright
    Loop
  }
}

ACTOR BlueArmor : BasicArmorPickup 2019
{
  Radius 20
  Height 16
  Inventory.PickupMessage "$GOTMEGA" // "Picked up the MegaArmor!"
  Inventory.Icon "ARM2A0"
  Armor.SavePercent 50
  Armor.SaveAmount 200
  States
  {
  Spawn:
    ARM2 A 6
    ARM2 B 6 Bright
    Loop
  }
}

ACTOR ArmorBonus : BasicArmorBonus 2015
{
  Radius 20
  Height 16
  Inventory.PickupMessage "$GOTARMBONUS" // "Picked up an armor bonus."
  Inventory.Icon "ARM1A0"
  Armor.SavePercent 33.335
  Armor.SaveAmount 1
  Armor.MaxSaveAmount 200
  +COUNTITEM
  +INVENTORY.ALWAYSPICKUP
  States
  {
  Spawn:
    BON2 ABCDCB 6
    Loop
  }
}

// Health

ACTOR Health : Inventory native
{
  Inventory.Amount 1
  Inventory.MaxAmount 0
  Inventory.PickupSound "misc/health_pkup"
}

ACTOR Medikit : Health 2012
{
  Inventory.Amount 25
  Inventory.PickupMessage "$GOTMEDIKIT" // "Picked up a medikit."
  Health.LowMessage 25, "$GOTMEDINEED" // "Picked up a medikit that you REALLY need!"
  States
  {
  Spawn:
    MEDI A -1
    Stop
  }
}

ACTOR Stimpack : Health 2011
{
  Inventory.Amount 10
  Inventory.PickupMessage "$GOTSTIM" // "Picked up a stimpack."
  States
  {
  Spawn:
    STIM A -1
    Stop
  }
}

ACTOR HealthBonus : Health 2014
{
  +COUNTITEM
  +INVENTORY.ALWAYSPICKUP
  Inventory.Amount 1
  Inventory.MaxAmount 200
  Inventory.PickupMessage "$GOTHTHBONUS" // "Picked up a health bonus."
  States
  {
  Spawn:
    BON1 ABCDCB 6
    Loop
  }
}

